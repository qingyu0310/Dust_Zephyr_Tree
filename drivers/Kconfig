config DUST_DEV_FSMC
    bool "STM32 FSMC LCD controller (HX8357DN 8080)"
    default n
    help
      FSMC 底层设备驱动：读 lcd_fsmc 节点时序/背光属性，配置 Bank 寄存器。

config DUST_DEV_FSMC_INIT_PRIORITY
    int "FSMC init priority"
    default 40
    help
      FSMC 设备初始化优先级（POST_KERNEL 阶段，需早于 LCD 业务线程）。

# USB 板卡底层 HAL（2026-08-09 从 framework/drivers/communication/stream/usb 下沉）
config DUST_USB_DEVICE_HAL_HPM
    bool "HPMicro EHCI USB HAL"
    default n

config DUST_USB_DEVICE_HAL_STM32
    bool "STM32 OTG FS USB HAL"
    default n
    select USE_STM32_HAL_PCD
    select USE_STM32_HAL_PCD_EX
    select USE_STM32_LL_USB
    help
      STM32F407 OTG FS 板卡底层 HAL（参考 STM32Cube USB_DEVICE CDC 设置，2026-08-13）。
      select USE_STM32_HAL_PCD* 触发 hal_stm32 模块编译 stm32f4xx_hal_pcd{,_ex}.c；
      USE_STM32_LL_USB 编译 stm32f4xx_ll_usb.c（HAL_PCD 依赖的 USB_* 底层函数）。

# EtherCAT ESC HAL（2026-10-29 从 sdk_glue_user 下沉，照 USB 分层）
# PHY 是 framework/drivers/device 下的设备模块，由业务线程（trd）组装时选用。
config DUST_ECAT_HAL_HPM
    bool "HPMicro ESC EtherCAT HAL"
    default n
    select CLOCK_CONTROL
    select GPIO
    select PINCTRL
    select HPM_ESC
    help
      HPMicro 片内 ESC 的 HAL 实现：EcatEsc 契约的厂商落地（含 SII 两种介质）。
      只提供底层 API 的隔离层，不含 PHY。

# fatal 异常栈帧转储（芯片相关，2026-10-20）
config DUST_FATAL_ESF_HPM
    bool "HPM RISC-V esf dump"
    default n
    select RISCV
    help
      RISC-V 异常栈帧转储：mcause / mtval / mepc / mstatus / ra / a0 / a1。
      fatal.cpp 内提供 __weak 空实现，未开启时链接不报错。

config DUST_FATAL_ESF_STM32
    bool "STM32 Cortex-M esf dump"
    default n
    select CPU_CORTEX_M
    help
      Cortex-M 异常栈帧转储：pc / xpsr / lr。
      fatal.cpp 内提供 __weak 空实现，未开启时链接不报错。
