# 维护者业务项目 Kconfig（位置 A：zephyr_user/project）
# 业务门禁符号（PRJ_MAIN / TRD_XXX / USE_XXX）保持原名，不加 DUST_ 前缀
# 业务门禁 select 的架构符号统一 DUST_ 前缀

config DEBUG_LOG
    bool "Enable Zephyr LOG output"
    default n
    select LOG
    select LOG_BACKEND_UART

config PRJ_MAIN
    bool "Main business project"
    default n
    select DEBUG_LOG

if PRJ_MAIN

# ===== 1) rsource 框架各层 Kconfig（位置 A）================================
rsource "../framework/drivers/Kconfig"
rsource "../framework/algorithm/Kconfig"
rsource "../framework/modules/Kconfig"
rsource "../framework/topic/Kconfig"
rsource "../framework/cmd/Kconfig"
rsource "../framework/drivers/communication/stream/usb/Kconfig"
# 注：init/ 无独立 Kconfig 且始终编译，不 rsource。

# ============================================================================

# =================       功能配置区 — 各模块开关       ========================

config USE_CMD_SHELL
    bool "Shell debug thread"
    default n
    select DUST_CMD_SHELL_VAR
    help
      Shell debug variable thread — l/g/s commands via UART.

config USE_CMD_BUZZER
    bool "Buzzer control"
    default n
    select DUST_CMD_BUZZER
    help
      Buzzer control — PWM beep via cmd/buzzer.

config USE_CMD_FLASH
    bool "SPI Flash"
    default y
    select DUST_CMD_FLASH
    help
      SPI NOR Flash read/write/erase via cmd/flash.

# ============================================================================

# =================               TRD_GPIO                ====================

config TRD_GPIO
    bool "GPIO thread task"
    default y
    select DUST_DEV_GPIO_OUTPUT
    select DUST_CTL_TIMER
    help
      Enable the GPIO/output indicator thread.

# ============================================================================

# =================               TRD_CHASSIS             ====================

config TRD_CHASSIS
    bool "Chassis control thread"
    default n
    select DUST_MOD_CTL_POWER
    select DUST_MOD_DEV_MOTOR_DJI
    select DUST_TPC_TO_CAN_TX
    select DUST_TPC_REMOTE_TO
    help
      Enable chassis control thread.

config USE_POWERMETER
    bool "Power meter"
    depends on TRD_CHASSIS
    default n
    select DUST_MOD_DEV_POWERMETER
    help
      Enable power meter support for chassis control.

# ============================================================================

# =================               TRD_GIMBAL               ====================

config TRD_GIMBAL
    bool "Gimbal control thread"
    default n
    select DUST_CTL_PID
    select DUST_MOD_DEV_MOTOR_DM
    select DUST_TPC_TO_CAN_TX
    select DUST_TPC_REMOTE_TO
    help
      Enable gimbal control thread.

# ============================================================================

# =================               TRD_CAN_TX              ====================

config TRD_CAN_TX
    bool "CAN TX thread"
    default n
    select DUST_COM_CAN
    select DUST_TPC_TO_CAN_TX
    help
      Enable CAN TX thread.

# ============================================================================

# =================               TRD_REMOTE              ====================

config TRD_REMOTE
    bool "Remote thread"
    default n
    select DUST_MOD_DEV_REMOTE
    select DUST_MOD_DEV_REMOTE_AUTO
    help
      Enable remote receiver thread.

# ============================================================================

# =================               TRD_IMU                 ====================

config TRD_IMU
    bool "IMU thread"
    default n
    select DUST_MOD_DEV_IMU
    select DUST_TPC_IMU_TO
    help
      Enable IMU acquisition, heater control, and publish thread.

config IMU_IDENTIFICATION
    bool "IMU heater identification"
    default n
    depends on TRD_IMU
    select DUST_MOD_DEV_IMU_IDENT
    help
      IMU heater open-loop identification, replaces PID closed-loop control.

# ============================================================================

# =================               TRD_PC                  ====================

config TRD_PC
    bool "PC communication thread"
    default n
    select DUST_COM_USB
    help
      PC communication thread (USB CDC ACM loopback test).

# ============================================================================

# =================               TRD_TEST                ====================

config TRD_TEST
    bool "User test add config"
    default n
    select DUST_DEV_PWM
    help
      Temporary user test switch.

# ============================================================================

endif # PRJ_MAIN

source "Kconfig.zephyr"
